PORT=5000
NODE_ENV=development

# Database
MONGO_URI=
MONGODB_URI=
DB_URL=

# Auth
JWT_SECRET=
JWT_REFRESH_SECRET=

# Mail
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=false
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# Company / Branding
COMPANY_NAME=

# BioCloud / Biometric Device Sync
BIOCLOUD_API_URL=
BIOCLOUD_API_TOKEN=
BIOCLOUD_RETRY_ATTEMPTS=3
BIOCLOUD_SYNC_INTERVAL=10
BIOCLOUD_SWEEP_TRAILING_DAYS=3
# Optional (YYYY-MM-DD): the manual "Sync" button in the UI pulls from this date up to today and
# rebuilds attendance for every punch in that range (leave empty to sync today only). The
# 10-minute automatic sync is not affected.
BIOCLOUD_SYNC_START_DATE=
# Employees created/imported in HRMS are added to BioCloud automatically and queued onto the
# device(s) chosen on their profile (Masters > HR Management > Biometric Devices).
# Employees with no device chosen fall back to the two settings below: an area name (all
# devices in that area) and/or device serial numbers (comma separated). Leave both empty to
# only add such employees to the BioCloud database.
BIOCLOUD_DEFAULT_AREA=
BIOCLOUD_DEVICE_SERIALS=

# AWS / S3
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_BUCKET_NAME=
AWS_S3_ENDPOINT=
AWS_S3_PUBLIC_BASE_URL=
